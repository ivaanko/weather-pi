# OpenWeatherMap location and API key
location="Paris,fr"
OWM_KEY="replace_with_your_openweathermap_api_key"

# Grafana Cloud endpoints and usernames. Leave blank to disable annotations,
# or configure both GRAFANA_URL and GRAFANA_TOKEN.
GRAFANA_URL=""
GRAFANA_TOKEN=""

# Prometheus remote_write (Mimir) and Loki endpoints/usernames
MIMIR_URL="https://prometheus.example/api/prom/push"
MIMIR_USER="replace_with_metrics_username"
LOKI_URL="https://logs.example/loki/api/v1/push"
LOKI_USER="replace_with_logs_username"
